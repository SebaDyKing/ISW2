{
  "info": {
    "name": "CleanPro — RF3 Hoja de Vida y RF4 Licencia Medica",
    "description": "Pruebas de API para RF3 (Hoja de Vida) y RF4 (Licencia Medica) del Sistema CleanPro. Base: {{base_url}}. Seed: empleado=1, admin=1, supervisor=1. Login: juan@test.cl / ana@test.cl con password123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "0. Autenticacion",
      "item": [
        {
          "name": "Login empleado (Juan) — necesario para subir licencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Autentica al empleado. Guarda accessToken/refreshToken en cookies HttpOnly. Habilita 'Cookies' en Postman para que se envien solas en la subida de licencia (POST).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan@test.cl\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 login OK\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        },
